{
  "name": "the-great-expedition-2027",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive expedition atlas and collective decision tool for a February-March 2027 trip.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-destinations.ts",
    "images": "node scripts/fetch-images.mjs",
    "credits": "tsx scripts/build-credits.ts",
    "backend:registry": "tsx scripts/build-backend-registry.ts",
    "backend:bundle": "node scripts/bundle-backend.mjs",
    "codes": "node scripts/generate-access-codes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "admin-key": "node scripts/admin-key.mjs",
    "prompts": "tsx scripts/prompts.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "maplibre-gl": "^6.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "recharts": "^3.11.2",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
