      "journeyTime": "≈ 4 h 40 min direct; 7–10 h with one stop",
      "baggage": "<what the fare includes>",
      "perPersonEUR": { "economical": 280, "realistic": 380, "comfortable": 550 },
      "confidence": "representative",     // observed = an actual quotation you saw; representative = typical/historical; estimate = planning guess
      "checkedAt": "2026-11-27",
      "priceNote": "<what the figure is based on; never present an estimate as a live quote>",
      "alternatives": [ { "airport": { "name": "Amsterdam Schiphol", "iata": "AMS" }, "realisticPerPersonEUR": 400, "confidence": "estimate", "note": "" } ],
