// Structural skeleton for data/destinations/DXX-slug.json (comments are NOT allowed in the real file).
// The authoritative schema is src/types/destination.ts. Arrays show one element; add as many as needed.
{
  "id": "D07",                       // your assigned id
  "slug": "jordan",
  "version": "1.0.0",
  "lastUpdated": "2026-11-27",
  "country": "Jordan",
  "region": "Wadi Rum, Petra and the Dana Biosphere",
  "continent": "Middle East",        // Asia | Middle East | Africa | Europe | North America | Central America | South America | Oceania
  "title": "Jordan — <specific, memorable expedition title>",
  "subtitle": "<one line>",
  "summary": "<1–2 sentences for tooltips and the comparison table>",
  "introduction": "<80–120 words, concrete, no marketing clichés>",
  "exceptional": {
    "vsOman": "<how it differs from the group's previous 15-day Oman road trip with tents>",
    "vsPackageTourism": "<…>",
    "vsPortfolio": "<what no other destination in the portfolio offers>"
  },
  "coordinates": { "lat": 30.0, "lng": 35.5, "label": "Southern Jordan" },   // centre of the EXPEDITION REGION, not the capital
  "duration": { "totalDays": 13, "internationalTravelDays": 2, "note": "Includes outbound and return flight days" },
  "recommendedTravelWindow": { "preferredMonth": "March", "window": "13–25 March 2027", "rationale": "<…>" },
  "februarySuitability": { "rating": "good", "summary": "<…>" },   // excellent | good | fair | poor | unsuitable
  "marchSuitability": { "rating": "excellent", "summary": "<…>" },
  "climate": {
    "regionNote": "<which stations / regions these figures describe>",
    "february": { "dayTempC": [12, 18], "nightTempC": [2, 6], "rainfall": "<…>", "humidity": "", "notes": "" },
