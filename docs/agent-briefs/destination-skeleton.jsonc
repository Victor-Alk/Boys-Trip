  },
  "culture": { "tags": ["archaeology", "nomadic-culture"], "summary": "<…>" },          // see CultureTag enum
  "culturalHighlights": [ { "name": "<…>", "kind": "archaeological site", "description": "<…>", "immersive": false } ],  // ≥ 3
  "adventureHighlights": [ { "name": "<…>", "description": "<…>", "requires": ["guide", "fitness"] } ],                // ≥ 2
  "signatureExperiences": [            // 3–5
    {
      "title": "<…>", "description": "<…>", "whyDistinctive": "<…>", "location": "<…>",
      "howToOrganise": "<…>", "costPerPersonEUR": 45, "costNote": "<basis>",
      "requiresGuide": true, "requiresPermit": false, "imageId": "D07-04", "sourceIds": ["S09"]
    }
  ],
  "travelStyle": { "primary": "road-trip", "tags": ["self-drive", "camping", "hiking"], "summary": "<…>" },
  "transport": {
    "summary": "<…>",
    "modes": [ { "mode": "Rental 4×4", "description": "<…>" } ],
