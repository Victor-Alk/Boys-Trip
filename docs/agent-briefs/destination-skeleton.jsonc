    "snowAndMountainAccess": "", "seaConditions": "", "airQuality": "", "wildlifeSeasonality": "",
    "holidaysAndFestivals": [ { "name": "Ramadan", "dates": "≈ 8 Feb – 9 Mar 2027 (moon-sighting dependent)", "impact": "<…>" } ],
    "ramadan2027": "<impact or 'Not relevant: …'>",
    "lunarNewYear2027": "<impact or 'Not relevant'>",
    "tourismDemand": "<…>",
    "flightPriceSeasonality": "<…>",
    "sourceIds": ["S05"]
  },
  "geography": {
    "tags": ["desert", "canyons", "mountains"],          // see GeographyTag enum
    "summary": "<…>",
    "distinctive": "<what is geographically unique, specifically>",
